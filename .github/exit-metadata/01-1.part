@@ -31,8 +37,18 @@ class ExitPayload:
     oca_type: str | None = None
     comment: str | None = None
     price_pair_policy: str = "absolute_first"
+    alert_message: str | None = None
+    disable_alert: bool = False
+    comment_profit: str | None = None
