+def test_close_only_does_not_invent_intrabar_crossings():
+    def commands(ctx, i):
+        if i == 0:
+            ctx.entry("L", "long", qty=1, stop=103)
+            ctx.exit("X", "L", profit=1)
+
+    _, result = run(
+        commands, candles((100, 101, 99, 100), (100, 106, 95, 102)), fill_model="close_only"
